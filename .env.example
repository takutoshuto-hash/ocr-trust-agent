# Gemini API（Google AI Studio のキー）。未設定ならモック抽出器で動く
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ストア: memory | firestore
STORE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=
FIRESTORE_COLLECTION_PREFIX=ocr_trust

# 画像保存: 未設定ならメモリ。Cloud Storage バケット名を入れると GCS に保存
GCS_BUCKET=

# ポリシー
POLICY_PATH=app/trust/policy.yaml
MODEL_DIR=models
